# ==============================================================================
# SportCrawl — Environment Configuration
# ==============================================================================

# ── Telegram Bot (Instant Fixture Digests & Interactive Commands) ────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_ID=your_chat_id_here

# ── SofaScore Scraping & Monitoring (2 Hours Interval = 7200 seconds) ────────
SOFASCORE_POLL_INTERVAL_SECONDS=7200
SOFASCORE_HEADLESS=true
SOFASCORE_TIMEOUT_MS=30000

# ── Option C: Daily Digest Delivery Windows (08:00, 15:00, 22:00 WAT) ────────
DAILY_DIGEST_ENABLED=true
DAILY_DIGEST_HOURS=8,12,17
SEND_DIGEST_FILES=true
MATCHES_FILE_FORMAT=both
APP_TIMEZONE=Africa/Lagos

# ── Featured Competitions (Comma-separated) ──────────────────────────────────
FEATURED_LEAGUES=Premier League,UEFA Champions League,UEFA Europa League,LaLiga,Serie A,Bundesliga,Ligue 1,FA Cup,Brasileirão Betano,Major League Soccer

# ── Individual Live Event Notifications (Disabled to avoid chat spam) ────────
NOTIFY_GOAL_EVENTS=false
NOTIFY_KICKOFF_EVENTS=false
NOTIFY_MATCH_ENDED=false

# ── Database & Cache ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./ginNews.sqlite
REDIS_URL=
DEDUP_TTL_SECONDS=86400

# ── Nightly Result Report ────────────────────────────────────────────────────
# Grades the day's logged tickets against SofaScore at NIGHTLY_REPORT_TIME and
# pushes WON / LOST / PENDING to Telegram, so results need no manual checking.
# Anything unfinished at report time is reported PENDING, never guessed.
# Re-run any night by hand with:  python3 -m tools.nightly_report --date YYYY-MM-DD
NIGHTLY_REPORT_ENABLED=true
NIGHTLY_REPORT_TIME=23:50
NIGHTLY_REPORT_SHOW_LEGS=true

# ── Ticket 2 (Top 20): markets beyond the measured seven ─────────────────────
# Corners, shots on target and team totals, so the mega accumulator stops being
# twenty entries of the same Over 1.5 model. TOP 10 IS NOT AFFECTED.
#
# These markets have NO graded hit rate and carry 5.8-8.2% margin against match
# goals' 3.8%. Every leg is flagged unvalidated in the digest and in the nightly
# report. TOP_EXTRA_MAX caps how many of the 20 legs may come from them.
#
# Set TOP_EXTRA_MARKETS=false to go back to the measured seven at any time.
TOP_EXTRA_MARKETS=true
TOP_EXTRA_MAX=8
TOP_EXTRA_CORNERS=true
TOP_EXTRA_SHOTS=true
TOP_EXTRA_TEAM_GOALS=true

# Spread the Top 20 across markets. Without a cap, ranking by probability always
# converges on the highest base rate, which is why the card filled with Over 1.5.
TOP_MAX_PER_MARKET=4
# New match-statistics requests allowed per run. Corner history must be banked
# before a corner line means anything; on day one nothing is banked, so this
# drains the backlog over several days rather than in one burst against a
# source that has throttled this IP before. A finished match is fetched once
# ever, so after the first week almost everything is a cache hit.
TOP_EXTRA_STATS_PER_RUN=120
