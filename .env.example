# ── Telegram Bot (Instant Fixture Digests & Interactive Commands) ────────────
TELEGRAM_BOT_TOKEN=8898111016:AAEeK0lcWHumB6LNcMFPaEofNQDUbngaiT8
ADMIN_CHAT_ID=801467766

# ── SofaScore Scraping & Monitoring ──────────────────────────────────────────
SOFASCORE_POLL_INTERVAL_SECONDS=120
SOFASCORE_HEADLESS=true
SOFASCORE_TIMEOUT_MS=30000

# ── Featured Competitions (Comma-separated) ──────────────────────────────────
